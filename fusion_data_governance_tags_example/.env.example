# Copy this file to `.env` and fill in your GCP project and BigQuery dataset:
#   cp .env.example .env
#   set -a && source .env && set +a

# Required: BigQuery project ID where dbt v2 / Fusion will materialize objects
GCP_PROJECT_ID=your-gcp-project-id

# Required: BigQuery dataset name (created automatically by dbt or setup script)
BQ_DATASET=dbt_fusion_dgt_example

# Optional: BigQuery dataset & Data Policy location (default: US)
BQ_LOCATION=US

# Optional: dbt target in profiles.yml (dev or prod, default: dev)
DBT_TARGET=dev

# Optional: Parent GCP Project ID, Project Number, or Organization ID that owns
# your Resource Manager DATA_GOVERNANCE Tag Keys. Defaults to GCP_PROJECT_ID.
# Uncomment to override (e.g. org-level tags):
# DGT_PARENT_ID=123456789012

# Optional: Isolated Tag Key short names (purpose=DATA_GOVERNANCE)
DGT_CLASS_KEY_NAME=dbt_fusion_dgt_class
DGT_DOMAIN_KEY_NAME=dbt_fusion_dgt_domain

# Optional: Path to your compiled local dbt v2 / Fusion binary
# DBT_FUSION_BIN=../../dbt/target/release/dbt
